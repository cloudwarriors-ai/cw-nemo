{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-task-list-item.schema.json",
  "type": "object",
  "description": "Compact task representation for project summaries.",
  "required": ["id", "title", "status", "assignee_human_id", "last_activity_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "_defs.schema.json#/definitions/id" },
    "title": { "$ref": "_defs.schema.json#/definitions/non_empty_string" },
    "status": { "$ref": "_defs.schema.json#/definitions/canonical_status" },
    "assignee_human_id": { "$ref": "_defs.schema.json#/definitions/id" },
    "assignee_agent_id": { "$ref": "_defs.schema.json#/definitions/id" },
    "last_activity_at": { "$ref": "_defs.schema.json#/definitions/iso8601_timestamp" }
  }
}
