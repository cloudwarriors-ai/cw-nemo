{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-draft.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "acceptance_criteria",
    "acceptance_signals",
    "depends_on_draft_ids",
    "rationale"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "_defs.schema.json#/definitions/id" },
    "title": { "$ref": "_defs.schema.json#/definitions/non_empty_string" },
    "description": { "type": "string" },
    "assignee_role_hint": { "$ref": "_defs.schema.json#/definitions/non_empty_string" },
    "acceptance_criteria": { "type": "string" },
    "acceptance_signals": {
      "type": "array",
      "items": { "$ref": "acceptance-signal.schema.json" }
    },
    "depends_on_draft_ids": {
      "type": "array",
      "items": { "$ref": "_defs.schema.json#/definitions/id" }
    },
    "rationale": { "$ref": "_defs.schema.json#/definitions/non_empty_string" }
  }
}
