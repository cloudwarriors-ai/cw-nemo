# Copy to .env and fill with your credentials

# ── Model Providers ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
OPENROUTER_API_KEY=sk-or-v1-...

# ── Zoom S2S OAuth (Team Chat App) ──────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_BOT_JID=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_PREFILTER_MODEL=anthropic/claude-haiku-4.5
ZOOM_PREFILTER_ENABLED=true

# ── Zoom S2S OAuth (Admin Reports — chat history ingest) ────────
ZOOM_REPORT_ACCOUNT_ID=${ZOOM_ACCOUNT_ID}
ZOOM_REPORT_CLIENT_ID=
ZOOM_REPORT_CLIENT_SECRET=
ZOOM_REPORT_USER=

# ── Platform Integrations ───────────────────────────────────────
ZW2_URL=https://dev2.api.zoomwarriors.com
ZW2_USERNAME=
ZW2_PASSWORD=

TESSERACT_URL=https://api.tesseract.pscx.ai
TESSERACT_USERNAME=
TESSERACT_PASSWORD=

PROJECT_PULSE_URL=https://projectpulse.pscx.ai
PROJECT_PULSE_EMAIL=
PROJECT_PULSE_PASSWORD=

# ── Service URLs ────────────────────────────────────────────────
BIGHEAD_API_URL=http://bighead:8000
DEVTOOLS_API_URL=

# ── GitHub Bot ──────────────────────────────────────────────────
GITHUB_BOT_API_URL=
GITHUB_BOT_API_SECRET=
GITHUB_BOT_WEBHOOK_SECRET=

# ── Twilio (WhatsApp) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# ── Admin ───────────────────────────────────────────────────────
ADMIN_DOMAIN=cloudwarriors.ai
ADMIN_USERS=

# ── Gateway ─────────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=
