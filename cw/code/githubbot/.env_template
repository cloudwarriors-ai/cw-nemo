GITHUB_WEBHOOK_SECRET=8675309
GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY=your_private_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
DJANGO_SECRET_KEY=your_django_secret_key_here

# Zoom Bot Settings
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
ZOOM_BOT_JID=your_bot_jid@xmpp.zoom.us
ZOOM_CHANNEL_ID=your_channel_id@conference.xmpp.zoom.us
ZOOM_ACCOUNT_ID=your_zoom_account_id_here

# GitHub Issue Maker Zoom App
ZOOM_ISSUE_MAKER_CLIENT_ID=your_issue_maker_client_id_here
ZOOM_ISSUE_MAKER_CLIENT_SECRET=your_issue_maker_client_secret_here
ZOOM_ISSUE_MAKER_BOT_JID=your_issue_maker_bot_jid@xmpp.zoom.us
ZOOM_DEVOPS_CHANNEL_ID=your_devops_channel_id@conference.xmpp.zoom.us

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Redis Configuration (for enhanced issue validation)
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM Validation Configuration
OPENAI_VISION_MODEL=gpt-4-turbo
OPENAI_VISION_MAX_TOKENS=1500
OPENAI_VALIDATION_TIMEOUT=15

# Validation Thresholds
VALIDATION_SCORE_EXCELLENT=80
VALIDATION_SCORE_GOOD=60
VALIDATION_SCORE_NEEDS_WORK=40
MAX_VALIDATION_ATTEMPTS=3

# Rate Limiting
MAX_VALIDATIONS_PER_USER_PER_HOUR=10
MAX_VALIDATIONS_PER_CHANNEL_PER_HOUR=50
DAILY_VALIDATION_BUDGET_USD=3.00

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=300

# Feature Flags
ENABLE_ENHANCED_ISSUE_MODE=true

# Project Pulse Integration (optional)
PROJECT_PULSE_API_URL=https://projectpulse.pscx.ai/api/v1
PROJECT_PULSE_API_SECRET=your_project_pulse_secret_here
