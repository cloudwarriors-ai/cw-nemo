# =============================================================================
# QA Continuity App - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# GitHub Configuration
# =============================================================================

# GitHub Personal Access Token (with repo read access)
# Get one at: GitHub > Settings > Developer settings > Personal access tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub Organization (optional - defaults to cloudwarriors-ai)
GITHUB_ORG=cloudwarriors-ai

# Repositories to monitor (comma-separated)
REPOS=repo1,repo2,repo3

# =============================================================================
# Zoom Configuration (Phase 1 - Chat Bot)
# =============================================================================

# Zoom Incoming Webhook URL (for scheduled reports)
# Get one at: Zoom Marketplace > Build App > Incoming Webhook
ZOOM_WEBHOOK_URL=https://zoom.us/webhook/xxxxxx

# Zoom Bot Verification Token (for interactive bot)
# Get from: Zoom Marketplace > Your App > Features > Chatbot > Verification Token
ZOOM_BOT_VERIFICATION_TOKEN=xxxxxxxx

# Zoom Bot Secret Token (for HMAC signature verification)
# Get from: Zoom Marketplace > Your App > Features > Chatbot > Secret Token
ZOOM_BOT_SECRET_TOKEN=xxxxxxxx

# Escalation contact (Zoom @mention for human handoff)
ESCALATION_CONTACT=@chad3

# =============================================================================
# n8n Workflow Automation (Phase 2)
# =============================================================================

# Base URL for n8n webhook triggers
# Get from: n8n > Workflow > Webhook node > Production URL (without path)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# Secret for authenticating n8n callbacks (use a secure random string)
# n8n should send this in X-Callback-Secret header or "secret" field in body
N8N_CALLBACK_SECRET=your-secure-random-secret

# =============================================================================
# Recall.ai Configuration (Phase 3 - Meeting Bot)
# =============================================================================

# Recall.ai API Key
# Get from: https://recall.ai dashboard
RECALL_API_KEY=xxxxxxxx

# Bot display name in meetings
RECALL_BOT_NAME=QA Bot

# Bot avatar image URL (256x256 or 512x512 recommended)
RECALL_BOT_IMAGE=https://your-domain.com/static/avatar.png

# Secret for Recall.ai transcription webhooks
# Set this in Recall.ai webhook configuration
RECALL_TRANSCRIPTION_SECRET=your-transcription-secret

# Maximum meetings per hour (rate limiting)
MEETING_RATE_LIMIT=5

# =============================================================================
# Voice Configuration (Phase 4 - Voice Pipeline)
# =============================================================================

# Enable voice features (set to "true" to enable)
VOICE_ENABLED=false

# OpenAI API Key (for Whisper ASR and optional TTS)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxx

# Cartesia API Key (for low-latency TTS - recommended)
# Get from: https://cartesia.ai dashboard
CARTESIA_API_KEY=xxxxxxxx

# Cartesia Voice ID (optional - uses default if not set)
# Find voice IDs in Cartesia dashboard
CARTESIA_VOICE_ID=

# =============================================================================
# Avatar Configuration (Phase 4 - Avatar)
# =============================================================================

# Enable avatar features (set to "true" to enable)
AVATAR_ENABLED=false

# Simli API Key (for avatar generation)
# Get from: https://app.simli.com/apikey
SIMLI_API_KEY=xxxxxxxx

# Simli Face ID (from Simli library or custom upload)
# Get from: https://app.simli.com/faces
SIMLI_FACE_ID=tmp9i8bbq7c

# Base URL for avatar page (for proxy/deployment scenarios)
# Leave empty to use request host automatically
AVATAR_PAGE_BASE_URL=

# =============================================================================
# LiveKit Configuration (Phase 5 - Real-Time Avatar)
# =============================================================================

# LiveKit Server URL
# Get from: https://livekit.io dashboard > Project Settings
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key
# Get from: https://livekit.io dashboard > Project Settings > Keys
LIVEKIT_API_KEY=APIxxxxxxxx

# LiveKit API Secret
# Get from: https://livekit.io dashboard > Project Settings > Keys
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxx

# Deepgram API Key (for streaming STT)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=xxxxxxxx

# =============================================================================
# Zoom Meeting SDK Configuration (Phase 5 - Native Zoom Bot)
# =============================================================================

# Zoom SDK Client ID
# Get from: Zoom Marketplace > Your App > App Credentials
ZOOM_SDK_CLIENT_ID=xxxxxxxx

# Zoom SDK Client Secret
# Get from: Zoom Marketplace > Your App > App Credentials
ZOOM_SDK_CLIENT_SECRET=xxxxxxxx

# =============================================================================
# Application Configuration
# =============================================================================

# Server port
PORT=5000

# API Key for internal endpoints (/api/query, /api/stats, etc.)
# [REQUIRED in production] - API requests will be rejected without this
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Database path (SQLite)
DB_PATH=data/state.db

# Issue cache TTL in seconds
CACHE_TTL=60

# User query rate limit (queries per hour)
RATE_LIMIT=20

# Log directory
LOG_DIR=logs

# =============================================================================
# Development Tools (Optional)
# =============================================================================

# Public URL for webhooks (ngrok URL or production domain)
# This is the externally-accessible URL for your bot
# Examples:
#   - ngrok: https://yousef-capacitive-misti.ngrok-free.dev
#   - production: https://qa-bot.yourdomain.com
PUBLIC_URL=https://yousef-capacitive-misti.ngrok-free.dev

# ngrok auth token (for local development with webhooks)
# Get from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# =============================================================================
# LLM Configuration (Future - Not yet implemented)
# =============================================================================

# Anthropic API Key (for Claude-powered natural language understanding)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OpenRouter API Key (for LLM Brain)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxx
MODEL=anthropic/claude-haiku-4.5

# =============================================================================
# Twilio Configuration (for SMS notifications)
# =============================================================================

# Twilio Account SID
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxx

# Twilio API Key SID and Secret
# Create at: https://console.twilio.com/us1/account/keys-credentials/api-keys
TWILIO_API_KEY_SID=SKxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxx

# Phone numbers for SMS notifications
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+1xxxxxxxxxx
